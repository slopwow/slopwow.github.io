# Gemini API (Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key-here

# Models (google-genai >= 3.2.0 Interactions API)
SLOPTOON_TEXT_MODEL=gemini-4-hydrogen
SLOPTOON_IMAGE_MODEL=gemini-nano-banana-2.1
# Alternatives for image model: gemini-3-pro-image, gemini-3.1-flash-lite-image

# Target DCInside minor gallery
SLOPTOON_GALLERY_ID=wowforever

# Public web archive base URL (used in DC upload pack body links)
SLOPTOON_ARCHIVE_BASE_URL=https://slopwow.github.io
